# کپی کنید به .env و مقدارها را پر کنید. این فایل‌ها هرگز در گیت قرار نمی‌گیرند.

# ---- API (.NET) ----
ASPNETCORE_ENVIRONMENT=Production
Database__Provider=SqlServer
ConnectionStrings__Default=Server=db;Database=MoravejiMotors;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True
Jwt__SigningKey=CHANGE_ME_TO_A_RANDOM_STRING_OF_AT_LEAST_32_CHARS
Otp__HashKey=CHANGE_ME_TO_ANOTHER_RANDOM_STRING_32_CHARS_MIN
Sms__Provider=Kavenegar
Sms__ApiKey=
Sms__OtpTemplate=moraveji-otp
Seed__AdminPhone=
Cors__AllowedOrigins__0=https://moravejimotors.ir

# ---- SQL Server container ----
MSSQL_SA_PASSWORD=CHANGE_ME

# ---- 21st.dev (only for installing UI components; keep in .env.local) ----
API_KEY_21ST=
