{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "SqlServer"
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "sitekit",
    "Audience": "sitekit-web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Otp": {
    "CodeLifetimeSeconds": 120,
    "ResendCooldownSeconds": 60,
    "MaxAttempts": 5,
    "MaxSendsPerWindow": 3,
    "WindowMinutes": 10
  },
  "Sms": {
    "Provider": "Kavenegar",
    "OtpTemplate": "site-otp"
  },
  "RateLimits": {
    "OtpPerTenMinutes": 5,
    "AuthPerMinute": 10,
    "FormsPerMinute": 5,
    "RefreshPerMinute": 60
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "TrustAllProxies": false
  },
  "Seed": {
    "Mode": "blank",
    "Preset": "services",
    "ContentFile": null,
    "AdminPhone": null,
    "StaffPhones": []
  },
  "Uploads": {
    "Path": ""
  }
}
