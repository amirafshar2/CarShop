{
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Default": "Data Source=/app/data/site.db"
  },
  "Sms": {
    "Provider": "Console"
  },
  "Demo": {
    "RevealCustomerOtp": false,
    "OpenAccess": false
  },
  "Otp": {
    "ResendCooldownSeconds": 20,
    "MaxSendsPerWindow": 6
  },
  "RateLimits": {
    "OtpPerTenMinutes": 30,
    "AuthPerMinute": 30,
    "FormsPerMinute": 20,
    "RefreshPerMinute": 120
  },
  "ForwardedHeaders": {
    "TrustAllProxies": true,
    "ForwardLimit": 2
  },
  "Seed": {
    "Mode": "blank",
    "Preset": "services",
    "ContentFile": null,
    "AdminPhone": null,
    "StaffPhones": []
  },
  "Uploads": {
    "Path": "/app/data/uploads"
  }
}
