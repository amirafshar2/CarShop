{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "SqlServer"
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "moraveji-motors",
    "Audience": "moraveji-web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Otp": {
    "CodeLifetimeSeconds": 120,
    "ResendCooldownSeconds": 60,
    "MaxAttempts": 5,
    "MaxSendsPerWindow": 3,
    "WindowMinutes": 10
  },
  "Sms": {
    "Provider": "Kavenegar",
    "OtpTemplate": "moraveji-otp"
  },
  "Reservation": {
    "HoldHours": 48,
    "DepositRial": 500000000
  },
  "RateLimits": {
    "OtpPerTenMinutes": 5,
    "AuthPerMinute": 10,
    "FormsPerMinute": 5,
    "RefreshPerMinute": 60
  },
  "Cors": {
    "AllowedOrigins": [ "https://moravejimotors.ir", "https://www.moravejimotors.ir" ]
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "TrustAllProxies": false
  },
  "Seed": {
    "DemoData": false,
    "AdminPhone": null,
    "StaffPhones": []
  }
}
