{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Default": "Data Source=moraveji-dev.db"
  },
  "Sms": {
    "Provider": "Console"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://127.0.0.1:3000" ]
  },
  "Otp": {
    "ResendCooldownSeconds": 10,
    "MaxSendsPerWindow": 10
  },
  "RateLimits": {
    "OtpPerTenMinutes": 30,
    "AuthPerMinute": 30,
    "FormsPerMinute": 20,
    "RefreshPerMinute": 120
  },
  "Seed": {
    "DemoData": true,
    "AdminPhone": "09120000001",
    "StaffPhones": [ "09120000002", "09120000003" ]
  }
}
